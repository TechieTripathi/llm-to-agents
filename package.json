{
  "name": "llm-to-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build --out exports/spa",
    "export": "slidev export --with-clicks --timeout 60000 --output exports/llm-agents-productivity-all-steps.pdf",
    "export:notes": "slidev export-notes --output exports/speaker-notes.pdf",
    "export:handout": "slidev export --timeout 60000 --output exports/llm-agents-productivity-handout.pdf",
    "check": "node scripts/check-deck.mjs && node --experimental-strip-types scripts/check-timing.mjs",
    "check:urls": "node scripts/check-urls.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.64.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  },
  "description": "65-slide Slidev workshop: From LLMs to AI Agents \u2014 Transforming Professional Productivity",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechieTripathi/llm-to-agents.git"
  },
  "homepage": "https://techietripathi.github.io/llm-to-agents/"
}
